// SQLite for local/dev. Production: PostgreSQL via DATABASE_URL.
//
// Domains:
//   Catalog  — Product, ProductColor, ProductVariant (stock), ProductImage
//   Auth     — User, Session
//   Customer — WishlistItem, Order, OrderItem, Payment, Review, SupportTicket
//   Content  — SiteSetting, InstagramMention
//
// Catalog copy is English-primary; Ukrainian in *Uk fields.
// Images: file paths/URLs in ProductImage (files live under /public or /uploads).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  placed
  paid
  processing
  shipped
  delivered
  /// Customer refused / didn't pick up — stock returned to warehouse
  returned
  cancelled
}

enum PaymentMethod {
  card
  apple_pay
  google_pay
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

enum TicketStatus {
  open
  escalated
  resolved
}

enum ReturnReason {
  defective
  quality_dislike
  wrong_size
  other
}

enum ReturnRequestStatus {
  requested
  approved
  rejected
  awaiting_parcel
  received
  refunded
  exchanged
  closed
}

// ─── Auth ───────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(USER)
  /// JSON: { locale?, newsletter? }
  settings     String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders         Order[]
  wishlist       WishlistItem[]
  reviews        Review[]
  tickets        SupportTicket[]
  returnRequests ReturnRequest[]
  sessions       Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Catalog (admin / shop inventory) ───────────────────

model Product {
  id             String   @id @default(cuid())
  slug           String   @unique
  /// English (canonical in DB)
  name           String
  nameUk         String   @default("")
  category       String // sweaters | tshirts | scarves
  description    String
  descriptionUk  String   @default("")
  /// JSON string[] English
  details        String   @default("[]")
  /// JSON string[] Ukrainian
  detailsUk      String   @default("[]")
  price          Int
  salePrice      Int?
  /// Portrait / figure label, English transliteration
  figure         String?
  figureUk       String?
  featured       Boolean  @default(false)
  newArrival     Boolean  @default(false)
  active         Boolean  @default(true)
  /// JSON string[] search tags (both languages welcome)
  tags           String   @default("[]")
  /// JSON size chart
  sizeChart      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images     ProductImage[]
  colors     ProductColor[]
  variants   ProductVariant[]
  reviews    Review[]
  wishlist   WishlistItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([featured])
  @@index([active])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Public path e.g. /products/galleries/x/01.jpg or /uploads/...
  url       String
  sortOrder Int     @default(0)
  alt       String?

  @@index([productId])
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String // black, bone, …
  name      String // English
  nameUk    String @default("")
  hex       String
  sortOrder Int    @default(0)

  variants ProductVariant[]

  @@unique([productId, key])
}

/// SKU stock row (admin inventory)
model ProductVariant {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String
  color     ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size      String
  stock     Int          @default(0)
  sku       String?

  @@unique([productId, colorId, size])
  @@index([productId])
}

// ─── Customer / user-owned data ─────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id            String        @id
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(placed)
  paymentMethod PaymentMethod
  subtotal      Int
  shipping      Int
  total         Int
  customerName  String
  customerEmail String
  customerPhone String
  city          String
  address       String
  novaPoshta      String?
  /// TTN tracking number (Нова Пошта)
  novaPoshtaTtn   String?
  notes           String?
  /// true after stock was put back (cancel / return) — prevents double restore
  stockRestored   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items    OrderItem[]
  payments Payment[]
  returns  ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot at purchase (English name)
  name      String
  colorId   String
  colorName String
  size      String
  qty       Int
  price     Int
  image     String

  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  method      PaymentMethod
  status      PaymentStatus @default(pending)
  amount      Int
  currency    String        @default("UAH")
  externalId  String?
  payloadHash String
  raw         String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([payloadHash])
}

model Review {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int
  text      String
  city      String   @default("")
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([productId])
}

model SupportTicket {
  id           String       @id @default(cuid())
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  message      String
  status       TicketStatus @default(open)
  telegramSent Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ReturnRequest {
  id           String              @id @default(cuid())
  orderId      String
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  phone        String?
  reason       ReturnReason
  message      String
  adminNote    String?
  status       ReturnRequestStatus @default(requested)
  /// true after admin confirmed receipt and stock was restored for this request
  restoreStock Boolean             @default(false)
  refundWanted Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─── Site content / config ──────────────────────────────

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model InstagramMention {
  id        String  @id @default(cuid())
  handle    String
  caption   String
  image     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/// Snapshot of a hard-deleted product for backend recovery / audit.
/// Order history stays intact (OrderItem snapshots + productId → null).
model ProductArchive {
  id        String   @id @default(cuid())
  productId String
  slug      String
  name      String
  nameUk    String   @default("")
  /// Full JSON: product fields, colors, variants, images
  snapshot  String
  deletedBy String?
  deletedAt DateTime @default(now())

  @@index([productId])
  @@index([slug])
  @@index([deletedAt])
}
